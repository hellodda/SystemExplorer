;
; KernelExplorer.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = KernelExplorer.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
KernelExplorer.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%KernelExplorer.DeviceDesc% = KernelExplorer_Device, Root\KernelExplorer ; TODO: edit hw-id

[KernelExplorer_Device.NT]
CopyFiles = File_Copy

[File_Copy]
KernelExplorer.sys

;-------------- Service installation
[KernelExplorer_Device.NT.Services]
AddService = KernelExplorer,%SPSVCINST_ASSOCSERVICE%, KernelExplorer_Service_Inst

; -------------- KernelExplorer driver install sections
[KernelExplorer_Service_Inst]
DisplayName    = %KernelExplorer.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\KernelExplorer.sys

[KernelExplorer_Device.NT.Wdf]
KmdfService = KernelExplorer, KernelExplorer_wdfsect

[KernelExplorer_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "KernelExplorer Installation Disk"
KernelExplorer.DeviceDesc = "KernelExplorer Device"
KernelExplorer.SVCDESC = "KernelExplorer Service"
