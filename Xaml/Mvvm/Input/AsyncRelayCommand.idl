import "Mvvm/Input/RelayCommand.idl";

namespace SystemExplorer.Xaml.Mvvm.Input
{
    delegate Windows.Foundation.IAsyncAction AsyncExecuteHandler(Object parameter);

    [flags]
    enum AsyncRelayCommandOptions
    {
        None = 0x0,
        AllowConcurrentExecutions = 0x1,
        FlowExceptionsToTaskScheduler = 0x2
    };

    interface ICancellationAwareCommand
    {
        Boolean IsCancellationSupported { get; };
    }

    interface IAsyncRelayCommand requires IRelayCommand, ICancellationAwareCommand
    {
        Windows.Foundation.IAsyncAction ExecuteAsync(Object parameter);
        void Cancel();

        Windows.Foundation.IAsyncAction ExecutionTask { get; };

        Boolean IsRunning { get; };
        Boolean CanBeCanceled { get; };
        Boolean IsCancellationRequested { get; };
    }

    runtimeclass AsyncRelayCommand : [default] IAsyncRelayCommand
    {
        AsyncRelayCommand(AsyncExecuteHandler execute);
        //AsyncRelayCommand(AsyncExecuteHandler execute, AsyncRelayCommandOptions options);
        AsyncRelayCommand(AsyncExecuteHandler execute, CanExecuteHandler canExecute);        
        AsyncRelayCommand(AsyncExecuteHandler execute, CanExecuteHandler canExecute, AsyncRelayCommandOptions options);

        void NotifyCanExecuteChanged();
    }

    //[default_interface]
    //runtimeclass AsyncRelayCommandFactory
    //{
        //static IAsyncRelayCommand Make(AsyncExecuteHandler execute);
        //static IAsyncRelayCommand Make(AsyncExecuteHandler execute, AsyncRelayCommandOptions options);
        //static IAsyncRelayCommand Make(AsyncExecuteHandler execute, CanExecuteHandler canExecute);
        //static IAsyncRelayCommand Make(AsyncExecuteHandler execute, CanExecuteHandler canExecute, AsyncRelayCommandOptions options);
    //}
}