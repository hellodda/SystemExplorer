<?xml version="1.0" encoding="utf-8"?>
<essential:WindowEx
    x:Class="SystemExplorer.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:essential="using:WinUI3Package"
    xmlns:pages="using:SystemExplorer.Views.Pages"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="SystemExplorer">
    
    <essential:WindowEx.SystemBackdrop>
        <MicaBackdrop/>
    </essential:WindowEx.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <essential:ModernStandardWindowContextMenu x:Name="Menu" Window="{x:Bind}"/>
        </Grid.Resources>

        <pages:RootPage Grid.Row="1"/>
    </Grid>
</essential:WindowEx>
