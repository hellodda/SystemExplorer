<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:helpers="using:SystemExplorer.Helpers"
    xmlns:items="using:SystemExplorer.Core.Data.Items"
    Background="{ThemeResource App.Theme.BackgroundBrush}"
    mc:Ignorable="d">

    <!--<Page.Resources>
        <XamlUICommand x:Key="NavigateTo"
                       ExecuteRequested=""
                       Description="Navigate to type"/>
    </Page.Resources>-->
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image
            Grid.Row="0"
            Grid.RowSpan="2"
            Stretch="{x:Bind ViewModel.AppThemeBackgroundImageFit, Mode=OneWay}"
            HorizontalAlignment="{x:Bind ViewModel.AppThemeBackgroundImageHorizontalAlignment, Mode=OneWay}"
            VerticalAlignment="{x:Bind ViewModel.AppThemeBackgroundImageVerticalAlignment, Mode=OneWay}"
            Source="{x:Bind ViewModel.AppThemeBackgroundImageSource, Mode=OneWay}"
            Opacity="{x:Bind ViewModel.AppThemeBackgroundImageOpacity, Mode=OneWay}"/>

        <TitleBar
            Grid.Row="0"
            x:Name="AppTitleBar"
            Title="System Explorer"
            Subtitle="WIN-T1UUBJJ7V8I"
            Height="48"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            IsTabStop="True">
            
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Square150x150Logo.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <AutoSuggestBox 
                    x:Name="TitleBarSearchBox"
                    TextChanged="AutoSuggestBox_TextChanged"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                    QueryIcon="Find"
                    Width="400"
                    MinWidth="250"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="items:NavigationCatalogItem">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <IconSourceElement IconSource="{x:Bind Icon}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Name}"/>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <PersonPicture Width="30"
                               Height="30"
                               Initials="T1"
                               Tapped="PersonPictureTapped"
                               ToolTipService.ToolTip="WIN-T1UUBJJ7V8I"/>
            </TitleBar.RightHeader>
        </TitleBar>
        <!--TextChanged="SearchBox_TextChanged"-->
          <!--SuggestionChosen="SearchBox_SuggestionChosen"-->
         <!--QuerySubmitted="SearchBox_QuerySubmitted"-->
        <NavigationView
                 Grid.Row="1"
                 x:Name="NavView"
                 SelectionChanged="NavViewSelectionChanged"
                 IsSettingsVisible="True"
                 Style="{StaticResource StoreNavigationViewStyle}">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" 
                     Color="{ThemeResource SolidBackgroundFillColorBase}" 
                     Opacity="0.3"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>

                <NavigationViewItem
                    Content="{helpers:ResourceString Key=System}"
                    Tag="SystemExplorer.Views.Pages.System.SystemRootPage"
                    Icon="{toolkit:FontIcon Glyph=&#xE770;}"
                    >
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="Create live kernel dump file">
                                <MenuFlyoutItem Text="Full live krenel dump" Command="{x:Bind ViewModel.CreateLiveKernelMemoryDumpCommand}"/>
                                <MenuFlyoutItem Text="Kernel stacks memory dump"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="{helpers:ResourceString Key=Activities}"
                    Tag="SystemExplorer.Views.Pages.Activities.ActivitiesRootPage"
                    Icon="{toolkit:FontIcon Glyph=&#xF120;}"
                    />

            </NavigationView.MenuItems>
            
            <NavigationView.FooterMenuItems>
                <NavigationViewItem IsEnabled="False" SelectsOnInvoked="False" />
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame x:Name="NavFrame"/>
            </NavigationView.Content>
        </NavigationView>

    </Grid>
</Page>
