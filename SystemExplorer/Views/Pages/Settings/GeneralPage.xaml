<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xtc="using:XamlToolkit.WinUI.Controls"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:xaml="using:SystemExplorer.Xaml.Controls"
    xmlns:essential="using:WinUI3Package"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    >

    <Grid Padding="20">
        <StackPanel>
            <TextBlock FontSize="26"
                       Margin="0 10 0 0"
                       Text="General"/>

            <xaml:SimpleSettingsGroup Margin="0 -30 0 0">
                <xtc:SettingsCard
                    Header="Language"
                    Description="Select the application language"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xF2B7;}">

                    <ComboBox
                        SelectedIndex="0"
                        essential:ComboBoxHelper.AcrylicWorkaround="True">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Русский"/>
                        <ComboBoxItem Content="Հայերեն"/>
                    </ComboBox>
                </xtc:SettingsCard>
                <xtc:SettingsCard
                  Header="Real-time update speed"
                  Description="Select the update frequency for system resource usage reports"
                  HeaderIcon="{toolkit:FontIcon Glyph=&#xEC49;}">

                    <ComboBox
                        SelectedIndex="1"
                        essential:ComboBoxHelper.AcrylicWorkaround="True">
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Suspended"/>
                    </ComboBox>
                </xtc:SettingsCard>
                <xtc:SettingsCard
                    Header="Default start page"
                    Description="Specify which page to display when System Explorer starts"
                    HeaderIcon="{toolkit:FontIcon Glyph=&#xEB3B;}">

                    <ComboBox SelectedIndex="0"
                              essential:ComboBoxHelper.AcrylicWorkaround="True">
                        <ComboBoxItem Content="Processes"/>
                        <ComboBoxItem Content="Services"/>
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Users"/>
                    </ComboBox>
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>
            <xaml:SimpleSettingsGroup
                Header="Reset settings">
                <Button Content="Restore all settings to default"/>
            </xaml:SimpleSettingsGroup>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Page>
