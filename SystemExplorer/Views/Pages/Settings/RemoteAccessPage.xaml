<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.RemoteAccessPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:XamlToolkit.WinUI.Controls"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:essential="using:WinUI3Package"
    xmlns:xaml="using:SystemExplorer.Xaml"
    xmlns:items="using:SystemExplorer.Core.Data.Items"
    xmlns:selectors="using:SystemExplorer.Xaml"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="RemoteComputerItemTemplate" x:DataType="items:RemoteComputerItem">
            <Grid
                MinWidth="200" 
                MaxWidth="350" 
                MinHeight="120" 
                MaxHeight="180"
                CornerRadius="6"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ReadableName}"
                ToolTipService.ToolTip="{x:Bind ReadableName}"
                DoubleTapped="OnComputerItemDoubleTapped">

                <Grid.ContextFlyout>
                    <CommandBarFlyout>
                        <AppBarButton Width="75" Icon="{toolkit:FontIcon FontSize=16, Glyph=&#xE95F;}" Label="Подкл."/>
                        <AppBarButton Width="75" Icon="{toolkit:FontIcon FontSize=16, Glyph=&#xE734;}" Label="Избрать"/>

                        <CommandBarFlyout.SecondaryCommands>
                            <AppBarButton Label="Настроить"/>
                            <AppBarButton Label="Дублировать"/>
                            <AppBarSeparator/>
                            <AppBarButton Label="Удалить" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </CommandBarFlyout.SecondaryCommands>
                    </CommandBarFlyout>
                </Grid.ContextFlyout>

                <Image HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Stretch="UniformToFill"
                       Source="/Assets/waves.jpg"/>

                <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Height="55"
                    Padding="8,6,8,6">
                    <Border.Background>
                        <AcrylicBrush TintColor="Black" TintOpacity="0.1" FallbackColor="#80000000"/>
                    </Border.Background>

                    <Grid VerticalAlignment="Center">
                        <StackPanel Spacing="1" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ReadableName}"
                                       FontSize="14"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="10"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Spacing="1" HorizontalAlignment="Right">
                            
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AddButtonItemTemplate">
            <Button
                MinWidth="200" 
                MaxWidth="350" 
                MinHeight="120" 
                MaxHeight="180"
                CornerRadius="6"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                Click="OnAddDeviceButtonClicked">

                <StackPanel Spacing="12">
                    <FontIcon Glyph="&#xE710;" FontSize="36" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Добавить устройство" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <selectors:ItemTemplateSelector x:Key="ItemTemplateSelector"
                                        Key="ADD_BUTTON"
                                        PrimaryTemplate="{StaticResource RemoteComputerItemTemplate}"
                                        SecondaryTemplate="{StaticResource AddButtonItemTemplate}"/>
    </Page.Resources>
    
    <Grid>
        <ContentDialog x:Name="RemoteComputerSetupDialog"
           PrimaryButtonText="Сохранить"
           DefaultButton="Primary"
           CloseButtonText="Отмена">

            <StackPanel Spacing="10">
                <StackPanel.Resources>
                    <Style TargetType="ui:HeaderedContentControl">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </StackPanel.Resources>

                <ui:HeaderedItemsControl Header="Общее">
                    <ui:HeaderedContentControl Header="Имя компьютера">
                        <TextBox PlaceholderText="Имя узла или IP адрес" Width="350"/>
                    </ui:HeaderedContentControl>

                    <ui:HeaderedContentControl Header="Читаемое имя компьютера">
                        <TextBox Width="350"/>
                    </ui:HeaderedContentControl>
                </ui:HeaderedItemsControl>

                <ui:HeaderedItemsControl Header="Аутентификация и учетные данные">
                    <ui:HeaderedContentControl Header="Имя пользователя">
                        <TextBox Width="350"/>
                    </ui:HeaderedContentControl>
                    <ui:HeaderedContentControl Header="Пароль">
                        <PasswordBox Width="350"/>
                    </ui:HeaderedContentControl>
                </ui:HeaderedItemsControl>
            </StackPanel>
        </ContentDialog>

        <StackPanel>
            <StackPanel Spacing="5">
                <GridView ItemsSource="{x:Bind ViewModel.Devices}"
                          ItemTemplateSelector="{StaticResource ItemTemplateSelector}">
                </GridView>

                <ui:SettingsExpander
                                    Header="Общие параметры подключения"
                                    HeaderIcon="{toolkit:FontIcon Glyph=&#xF080;}">
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard>
                            <ui:SettingsCard.Header>
                                <CheckBox IsChecked="False" Content="Включить проверочное соединение перед основным подключением"/>
                            </ui:SettingsCard.Header>
                        </ui:SettingsCard>
                        <ui:SettingsCard>
                            <ui:SettingsCard.Header>
                                <CheckBox IsChecked="False" Content="SYSX_IMPL_RaiseSystemHardError"/>
                            </ui:SettingsCard.Header>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <Border Height="20"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
