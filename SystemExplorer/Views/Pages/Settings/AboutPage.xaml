<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:ui="using:XamlToolkit.WinUI"
    xmlns:xaml="using:SystemExplorer.Xaml"
    xmlns:helpers="using:SystemExplorer.Helpers"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <x:String x:Key="IssuesUrl">https://github.com/hellodda/SystemExplorer/issues</x:String>
        <x:String x:Key="GitHubUrl">https://github.com/hellodda/SystemExplorer</x:String>
        <x:String x:Key="WinUIEssentialsUrl">https://github.com/HO-COOH/WinUIEssentials</x:String>
        <x:String x:Key="XamlToolkitUrl">https://github.com/lgztx96/CommunityToolkit.WinUI</x:String>
        <x:String x:Key="MicrosoftWilUrl">https://github.com/microsoft/wil</x:String>
        <x:String x:Key="PhntUrl">https://github.com/winsiderss/phnt</x:String>
        <x:String x:Key="DocumentationUrl">https://codewiki.google/github.com/hellodda/systemexplorer</x:String>
    </Page.Resources>

    <Grid>
        <StackPanel ChildrenTransitions="{StaticResource StackPanelsAnimations}">
            <StackPanel ChildrenTransitions="{StaticResource StackPanelsAnimations}" Spacing="5">
                              <Grid>
                    <StackPanel Spacing="10" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image Source="/Assets/updateicon.png" Height="100" Width="100"/>

                        <StackPanel Spacing="5">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="У вас установлена последняя версия программы"/>
                            <TextBlock Text="Время последней проверки: сегодня, 17:28"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </StackPanel>
            

            <xaml:SimpleSettingsGroup Header="{helpers:ResourceString Key=HelpAndSupport}">
                <controls:SettingsCard Header="{helpers:ResourceString Key=Documentation}"
                          Description="Learn how to use the app"
                          IsClickEnabled="True"
                          IsActionIconVisible="False"
                          HeaderIcon="{ui:FontIcon Glyph=&#xF7DB;}"
                          Command="{x:Bind ViewModel.LaunchUriCommand}"
                          CommandParameter="{StaticResource DocumentationUrl}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Questions and issues"
                          Description="Find solutions and report problems"
                          IsActionIconVisible="False"
                          IsClickEnabled="True"
                          Command="{x:Bind ViewModel.LaunchUriCommand}"
                          CommandParameter="{StaticResource IssuesUrl}"
                          HeaderIcon="{ui:FontIcon Glyph=&#xE8F2;}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Open logs"
                          Description="View application logs"
                          IsActionIconVisible="False"
                          IsClickEnabled="True"
                          HeaderIcon="{ui:FontIcon Glyph=&#xE838;}"
                          Command="{x:Bind ViewModel.OpenLogsCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </controls:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <xaml:SimpleSettingsGroup Header="{helpers:ResourceString Key=OpenSource}">
                <controls:SettingsExpander Header="Third-party libraries"
                                      Description="View application dependencies"
                                      HeaderIcon="{ui:FontIcon Glyph=&#xE90F;}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="5">
                                    <HyperlinkButton Content="WinUIEssential" NavigateUri="{StaticResource WinUIEssentialsUrl}"/>
                                    <HyperlinkButton Content="XamlToolkit" NavigateUri="{StaticResource XamlToolkitUrl}"/>
                                    <HyperlinkButton Content="Microsoft Wil" NavigateUri="{StaticResource MicrosoftWilUrl}"/>
                                    <HyperlinkButton Content="Phnt" NavigateUri="{StaticResource PhntUrl}"/>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard Header="Repository on GitHub"
                          Description="Source code is available on GitHub"
                          IsActionIconVisible="False"
                          IsClickEnabled="True"
                          Command="{x:Bind ViewModel.LaunchUriCommand}"
                          CommandParameter="{StaticResource GitHubUrl}"
                          HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </controls:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <Border Height="20"/>
        </StackPanel>
    </Grid>
</Page>
