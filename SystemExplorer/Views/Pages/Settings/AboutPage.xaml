<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xtc="using:XamlToolkit.WinUI.Controls"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:xaml="using:SystemExplorer.Xaml.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <x:String x:Key="IssuesUrl">https://github.com/hellodda/SystemExplorer/issues</x:String>
        <x:String x:Key="GitHubUrl">https://github.com/hellodda/SystemExplorer</x:String>
        <x:String x:Key="WinUIEssentialsUrl">https://github.com/HO-COOH/WinUIEssentials</x:String>
        <x:String x:Key="XamlToolkitUrl">https://github.com/lgztx96/CommunityToolkit.WinUI</x:String>
        <x:String x:Key="MicrosoftWilUrl">https://github.com/microsoft/wil</x:String>
        <x:String x:Key="PhntUrl">https://github.com/winsiderss/phnt</x:String>
    </Page.Resources>

    <Grid Padding="20">
        <StackPanel>
            <TextBlock FontSize="26" Margin="0 10 0 0" Text="About application"/>
            <xaml:SimpleSettingsGroup Margin="0 -30 0 0">
                <xtc:SettingsCard Header="SystemExplorer"
                                  Description="Version 1.0.0"
                                  HeaderIcon="{toolkit:FontIcon Glyph=&#xE946;}">
                    <Button Content="Copy" Width="100" />
                </xtc:SettingsCard>

                <xtc:SettingsCard IsClickEnabled="True"
                                  IsActionIconVisible="False"
                                  HeaderIcon="{toolkit:FontIcon Glyph=&#xEB51;}"
                                  Command="{x:Bind ViewModel.LaunchUriCommand}"
                                  CommandParameter="{StaticResource GitHubUrl}">
                    <xtc:SettingsCard.Header>
                        <TextBlock Text="Support us on GitHub"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="15"
                           FontWeight="SemiBold" />
                    </xtc:SettingsCard.Header>
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <xaml:SimpleSettingsGroup Header="Help and support">
                <xtc:SettingsCard Header="Documentation"
                          Description="Learn how to use the app"
                          IsClickEnabled="True"
                          IsActionIconVisible="False"
                          HeaderIcon="{toolkit:FontIcon Glyph=&#xF7DB;}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>

                <xtc:SettingsCard Header="Questions and issues"
                          Description="Find solutions and report problems"
                          IsActionIconVisible="False"
                          IsClickEnabled="True"
                          Command="{x:Bind ViewModel.LaunchUriCommand}"
                          CommandParameter="{StaticResource IssuesUrl}"
                          HeaderIcon="{toolkit:FontIcon Glyph=&#xE8F2;}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>

                <xtc:SettingsCard Header="Open logs"
                          Description="View application logs"
                          IsClickEnabled="True"
                          HeaderIcon="{toolkit:FontIcon Glyph=&#xE838;}">
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <xaml:SimpleSettingsGroup Header="Open source">
                <xtc:SettingsExpander Header="Third-party libraries"
                                      Description="View application dependencies"
                                      HeaderIcon="{toolkit:FontIcon Glyph=&#xE90F;}">
                    <xtc:SettingsExpander.Items>
                        <xtc:SettingsCard>
                            <xtc:SettingsCard.Header>
                                <StackPanel Spacing="5">
                                    <HyperlinkButton Content="WinUIEssential" NavigateUri="{StaticResource WinUIEssentialsUrl}"/>
                                    <HyperlinkButton Content="XamlToolkit" NavigateUri="{StaticResource XamlToolkitUrl}"/>
                                    <HyperlinkButton Content="Microsoft Wil" NavigateUri="{StaticResource MicrosoftWilUrl}"/>
                                    <HyperlinkButton Content="Phnt" NavigateUri="{StaticResource PhntUrl}"/>
                                </StackPanel>
                            </xtc:SettingsCard.Header>
                        </xtc:SettingsCard>
                    </xtc:SettingsExpander.Items>
                </xtc:SettingsExpander>

                <xtc:SettingsCard Header="Repository on GitHub"
                          Description="Source code is available on GitHub"
                          IsActionIconVisible="False"
                          IsClickEnabled="True"
                          Command="{x:Bind ViewModel.LaunchUriCommand}"
                          CommandParameter="{StaticResource GitHubUrl}"
                          HeaderIcon="{toolkit:FontIcon Glyph=&#xE774;}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Page>
