<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:SystemExplorer.Xaml.Controls"
    xmlns:xtc="using:XamlToolkit.WinUI.Controls"
    xmlns:xconverters="using:XamlToolkit.WinUI.Converters"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:helpers="using:SystemExplorer.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <xconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    
    <Grid Padding="20">
        <StackPanel>
            <TextBlock FontSize="26" Margin="0 10 0 0" Text="{x:Bind helpers:StringsHelper.Advanced}"/>

            <xaml:SimpleSettingsGroup Margin="0 -30 0 0">
                <xtc:SettingsCard Header="{x:Bind helpers:StringsHelper.ExportSettings}"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xE8B5;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.ExportSettingsCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="{x:Bind helpers:StringsHelper.ImportSettings}"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xEA52;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.ImportSettingsCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="Edit the settings file"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xE8DA;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.OpenSettingsFileCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
                <xtc:SettingsExpander
                     Header="Plugins"
                     HeaderIcon="{toolkit:FontIcon Glyph=&#xE71D;}">

                    <StackPanel Spacing="8" Orientation="Horizontal">
                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="14" Glyph="&#xEC26;"/>
                        <TextBlock Text="1 | Connections"/>
                    </StackPanel>
                    
                    <xtc:SettingsExpander.Items>
                        <xtc:SettingsCard HeaderIcon="{toolkit:FontIcon Glyph=&#xF158;}" Header="System Explorer VirusTotal Extension" Description="Author: Hellodda, Version: 1.0">
                            <ToggleSwitch IsOn="True"/>
                        </xtc:SettingsCard>
                        <xtc:SettingsCard HeaderIcon="{toolkit:FontIcon Glyph=&#xF158;}" Header="System Explorer AMSI Scan Tools" Description="Author: Hellodda, Version: 2.1">
                            <ToggleSwitch IsOn="False"/>
                        </xtc:SettingsCard>
                        <xtc:SettingsCard HeaderIcon="{toolkit:FontIcon Glyph=&#xEA39;}" Header="System Explorer Local AI Model" Description="Author: Hellodda, Version: Experimental">
                            <ToggleSwitch IsOn="False" IsEnabled="False"/>
                        </xtc:SettingsCard>
                    </xtc:SettingsExpander.Items>
                </xtc:SettingsExpander>
            </xaml:SimpleSettingsGroup>

            <xaml:SimpleSettingsGroup Header="{x:Bind helpers:StringsHelper.ExperimentalFunctions}">
                <xtc:SettingsCard 
                      Header="Advanced AI actions"
                      Description="Advanced system interaction: manage, create, and terminate processes with elevated access to core system information."
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xF277;}"
                      IsClickEnabled="False"
                      IsActionIconVisible="False"
                      IsEnabled="false">
                    <ToggleSwitch IsOn="false"/>
                    <!--<ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AdvancedAiAgent, Mode=TwoWay}"/>-->
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="Set System Explorer as the default task manager"
                       Description="This setting modifies the Windows registry and may have unexpected side effects on your device. Proceed at your own risk."
                       HeaderIcon="{toolkit:FontIcon Glyph=&#xEB3B;}"
                       IsEnabled="false">
                    <ToggleSwitch IsOn="false"/>
                    <!--<ToggleSwitch IsOn="{x:Bind ViewModel.Settings.InStartup, Mode=TwoWay}"/>-->
                </xtc:SettingsCard>
                <xtc:SettingsCard 
                      Header="{x:Bind helpers:StringsHelper.UseDriver}"
                      Description="Requires a secure connection"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xF211;}"
                      IsClickEnabled="False"
                      IsActionIconVisible="False"
                      IsEnabled="False">
                    <ToggleSwitch IsOn="False"/>
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Page>
