<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Settings.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:SystemExplorer.Xaml"
    xmlns:xtc="using:XamlToolkit.WinUI.Controls"
    xmlns:xconverters="using:XamlToolkit.WinUI.Converters"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:helpers="using:SystemExplorer.Helpers"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <xconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>
    
    <Grid>
        <StackPanel>
            <StackPanel Spacing="5">
                <xtc:SettingsCard Header="{helpers:ResourceString Key=ExportSettings}"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xE8B5;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.ExportSettingsCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="{helpers:ResourceString Key=ImportSettings}"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xEA52;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.ImportSettingsCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="Edit the settings file"
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xE8DA;}"
                      IsClickEnabled="True"
                      IsActionIconVisible="False"
                      Command="{x:Bind ViewModel.OpenSettingsFileCommand}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="15"/>
                </xtc:SettingsCard>
            </StackPanel>

            <xaml:SimpleSettingsGroup Header="{helpers:ResourceString Key=ExperimentalFunctions}">
                <xtc:SettingsCard 
                   Header="{helpers:ResourceString Key=UseDriver}"
                   Description="Requires a secure connection"
                   HeaderIcon="{toolkit:FontIcon Glyph=&#xF211;}"
                   IsClickEnabled="False"
                   IsActionIconVisible="False">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.UseDriverAsDataSource, Mode=TwoWay}"/>
                </xtc:SettingsCard>
                <xtc:SettingsCard 
                      Header="Advanced AI actions"
                      Description="Advanced system interaction: manage, create, and terminate processes with elevated access to core system information."
                      HeaderIcon="{toolkit:FontIcon Glyph=&#xF277;}"
                      IsClickEnabled="False"
                      IsActionIconVisible="False"
                      IsEnabled="false">
                    <ToggleSwitch IsOn="false"/>
                    <!--<ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AdvancedAiAgent, Mode=TwoWay}"/>-->
                </xtc:SettingsCard>
                <xtc:SettingsCard Header="Set System Explorer as the default task manager"
                       Description="This setting modifies the Windows registry and may have unexpected side effects on your device. Proceed at your own risk."
                       HeaderIcon="{toolkit:FontIcon Glyph=&#xEB3B;}"
                       IsEnabled="false">
                    <ToggleSwitch IsOn="false"/>
                    <!--<ToggleSwitch IsOn="{x:Bind ViewModel.Settings.InStartup, Mode=TwoWay}"/>-->
                </xtc:SettingsCard>
            </xaml:SimpleSettingsGroup>
            
            <Border Height="20"/>

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Page>
