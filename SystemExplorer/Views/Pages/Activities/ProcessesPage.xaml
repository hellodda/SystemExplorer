<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Activities.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Activities"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:controls="using:XamlToolkit.Labs.WinUI"
    xmlns:models="using:SystemExplorer.Models"
    xmlns:toolkit="using:XamlToolkit.WinUI"
    xmlns:convertes="using:SystemExplorer.Converters"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <convertes:ValueToSizeUnitConverter x:Key="SizeConverter"/>
        <convertes:StringFormatConverter x:Key="StringFormatConverter"/>
        
        <MenuFlyout x:Key="ProcessMenuFlyout">
            <MenuFlyoutItem Text="End task" Command="{x:Bind ViewModel.TerminateProcessCommand}"/>
            <MenuFlyoutItem Text="Suspend" />
            <MenuFlyoutItem Text="Restart"/>

            <MenuFlyoutSeparator/>

            <MenuFlyoutItem Text="Efficiency mode"/>
            <MenuFlyoutItem Text="Debug"/>
            <MenuFlyoutItem Text="Create memory dump file"/>

            <MenuFlyoutSeparator/>

            <MenuFlyoutItem Text="Go to detials"/>
            <MenuFlyoutItem Text="Open file location"/>
            <MenuFlyoutItem Text="Search online"/>
            <MenuFlyoutItem Text="Properties"/>
        </MenuFlyout>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Height="55"
                Padding="12"
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,0">

            <Grid VerticalAlignment="Center">
                
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           Text="Processes" />

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="10">

                    <Button Style="{ThemeResource FlatButtonStyle}">
                        <StackPanel Spacing="10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <FontIcon FontSize="15" Glyph="&#xEFDA;"/>
                            <TextBlock FontSize="14"
                                       Text="Run new task"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="30" 
                               Width="1"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" 
                            VerticalAlignment="Center"/>

                    <Button Style="{ThemeResource FlatButtonStyle}"
                            Command="{x:Bind ViewModel.TerminateProcessCommand, Mode=OneWay}">
                        <StackPanel Spacing="10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <FontIcon FontSize="15" Glyph="&#xE733;"/>
                            <TextBlock FontSize="14"
                                       Text="End task"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{ThemeResource FlatButtonStyle}"
                           >
                        <StackPanel Spacing="10"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <FontIcon FontSize="15" Glyph="&#xF1E8;"/>
                            <TextBlock FontSize="14"
                                       Text="Efficiency mode"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Background="Transparent"
                            BorderThickness="0"
                            >
                        <FontIcon Glyph="&#xE712;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ListView HorizontalAlignment="Stretch"
                  ItemContainerTransitions="{x:Null}"
                  SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}"
                  ItemsSource="{x:Bind ViewModel.Processes}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  x:Name="ProcessesList"
                  Grid.Row="1">
            <ListView.Header>
                <Border Height="50">

                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>

                    <controls:DataTable ColumnSpacing="0">

                        <controls:DataColumn
                               CanResize="True"
                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                               BorderThickness="0,0,1,1">
                            <TextBlock Text="Name" Margin="0 25 0 0" HorizontalAlignment="Left"/>
                        </controls:DataColumn>

                        <controls:DataColumn
                               CanResize="True"
                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                               BorderThickness="0,0,1,1">
                            <TextBlock Text="Status" Margin="0 25 0 0" HorizontalAlignment="Left"/>
                        </controls:DataColumn>

                        <controls:DataColumn
                             CanResize="True"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="0,0,1,1">
                            <TextBlock Text="PID" Margin="0 25 0 0" HorizontalAlignment="Right"/>
                        </controls:DataColumn>
                        
                        <controls:DataColumn CanResize="True"
                                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                             BorderThickness="0,0,1,1">
                            <StackPanel Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind ViewModel.TotalCpuUsage, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%', Mode=OneWay}" />
                                <TextBlock Text="CPU" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </controls:DataColumn>

                        <controls:DataColumn CanResize="True"
                                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                             BorderThickness="0,0,1,1">
                            <StackPanel Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind ViewModel.TotalIoRate, Mode=OneWay, Converter={StaticResource SizeConverter}, ConverterParameter='/s'}" HorizontalAlignment="Right"/>
                                <TextBlock Text="I/O total rate" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </controls:DataColumn>

                        <controls:DataColumn CanResize="True"
                                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                             BorderThickness="0,0,1,1">
                            <StackPanel Spacing="5" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind ViewModel.TotalPrivateBytes, Mode=OneWay, Converter={StaticResource SizeConverter}}" HorizontalAlignment="Right"/>
                                <TextBlock Text="Private bytes"/>
                            </StackPanel>
                        </controls:DataColumn>

                        <controls:DataColumn
                                       Width="2550"
                                       BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                       BorderThickness="0,0,1,1">
                            <TextBlock Text="Description" Margin="0 25 0 0" HorizontalAlignment="Left"/>
                        </controls:DataColumn>

                    </controls:DataTable>
                </Border>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProcessInformation">
                    <controls:DataRow HorizontalAlignment="Stretch"
                                      ContextFlyout="{StaticResource ProcessMenuFlyout}">
                        <controls:DataRow.Resources>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                            </Style>

                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </controls:DataRow.Resources>

                        <Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Source="/Assets/Square44x44Logo.png" Width="18" Height="18"/>
                                <TextBlock Text="{x:Bind Name}" />
                            </StackPanel>
                        </Border>

                        <Border>
                            <TextBlock Text="" />
                        </Border>

                        <Border>
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind  Pid}" />
                        </Border>

                        <Border>
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind CpuUsage, Mode=OneWay}" />
                        </Border>

                        <Border>
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind IoRate, Mode=OneWay, Converter={StaticResource SizeConverter}, ConverterParameter='/s'}" />
                        </Border>

                        <Border>
                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind PrivateBytes, Mode=OneWay, Converter={StaticResource SizeConverter}}" />
                        </Border>

                        <Border>
                            <TextBlock Text="{x:Bind Description}" />
                        </Border>

                    </controls:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}"
                       TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>