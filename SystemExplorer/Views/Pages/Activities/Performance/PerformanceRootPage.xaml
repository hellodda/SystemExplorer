<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SystemExplorer.Views.Pages.Activities.Performance.PerformanceRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SystemExplorer.Views.Pages.Activities.Performance"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:items="using:SystemExplorer.Core.Data.Items"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Height="55"
             Padding="12"
             VerticalAlignment="Top"
             Grid.Row="0"
             CornerRadius="8,0,0,0"
             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
             BorderThickness="1,1,1,0">

            <Grid VerticalAlignment="Center">

                <TextBlock HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="15" 
                    FontWeight="SemiBold" 
                    Text="Performance" />

                <StackPanel HorizontalAlignment="Right"
                     Orientation="Horizontal"
                     Spacing="10">

                    <Button Style="{ThemeResource FlatButtonStyle}">
                        <StackPanel Spacing="10"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">
                            <FontIcon FontSize="15" Glyph="&#xEFDA;"/>
                            <TextBlock FontSize="14"
                                Text="Run new task"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="30" 
                        Width="1"
                     Fill="{ThemeResource DividerStrokeColorDefaultBrush}" 
                     VerticalAlignment="Center"/>

                    <Button Background="Transparent"
                         BorderThickness="0">
                        <FontIcon Glyph="&#xE712;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="PerformanceNavView"
            Grid.Row="1"
            MenuItemsSource="{x:Bind ViewModel.NavigationViewItems}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>

                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>

                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>

                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>

            </NavigationView.Resources>

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="items:PerformanceNavigationViewItem">
                    <StackPanel Orientation="Horizontal" Height="60" Margin="0,5">
                        <Grid Width="80"
                              Height="50"
                              Margin="0,0,10,0"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="1">
                            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Polyline
                                    Stroke="{ThemeResource SystemAccentColor}" 
                                    StrokeThickness="1"
                                    StrokeLineJoin="Round"
                                    StrokeEndLineCap="Square"/>
                            </Canvas>
                        </Grid>
                      
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Header}"/>
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind SubDescription, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <NavigationView.MenuItems>
  
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ActivitiesFrame" x:FieldModifier="Public">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
