import "ViewModels/ViewModelBase.idl";
import "Xaml/Mvvm/AsyncRelayCommand.idl";
import "Core/Data/Items/AppThemeResourceItem.idl";

namespace SystemExplorer.ViewModels.Settings
{
    [bindable]
    [default_interface]
    runtimeclass AppearanceViewModel : SystemExplorer.ViewModels.ViewModelBase
    {
        AppearanceViewModel();

        Windows.Foundation.Collections.IObservableVector<SystemExplorer.Core.Data.Items.AppThemeResourceItem> AppThemeResources { get; };
        SystemExplorer.Core.Data.Items.AppThemeResourceItem SelectedAppThemeResources;

        Windows.Foundation.Collections.IVector<Object> BackdropMaterialTypes { get; };
        Object SelectedBackdropMaterial;    
        Int32 SelectedBackdropMaterialIndex;

        Windows.Foundation.Collections.IVector<Object> ImageStretchTypes { get; };
        Object SelectedImageStretchType;    
        Int32 SelectedImageStretchTypeIndex;

        Windows.Foundation.Collections.IVector<Object> ImageVerticalAlignmentTypes { get; };
        Object SelectedImageVerticalAlignmentType;    
        Int32 SelectedImageVerticalAlignmentTypeIndex;

        Windows.Foundation.Collections.IVector<Object> ImageHorizontalAlignmentTypes { get; };
        Object SelectedImageHorizontalAlignmentType;    
        Int32 SelectedImageHorizontalAlignmentTypeIndex;

        Single AppThemeBackgroundImageOpacity;
        Int32 SelectedAppThemeIndex;

        String AppThemeBackgroundImageSource;
        String AppThemeBackgroundColor;

        SystemExplorer.Xaml.IAsyncRelayCommand SelectImageCommand { get; };
        SystemExplorer.Xaml.IAsyncRelayCommand RemoveImageCommand { get; };
    }
}
