import "Core/Settings/AppearanceSettings.idl";
import "Models/Items/AppThemeResourceItem.idl";

namespace SystemExplorer.ViewModels.Settings
{
    [bindable]
    [default_interface]
    runtimeclass AppearanceViewModel 
    {
        AppearanceViewModel();

        Windows.Foundation.Collections.IObservableVector<SystemExplorer.Models.Items.AppThemeResourceItem> AppThemeResources { get; };
        SystemExplorer.Models.Items.AppThemeResourceItem SelectedAppThemeResources;

        Windows.Foundation.Collections.IVector<Object> BackdropMaterialTypes { get; };
        Object SelectedBackdropMaterial;    
        Int32 SelectedBackdropMaterialIndex;

        Int32 SelectedAppThemeIndex;

        String AppThemeBackgroundColor;
    }
}
