;
; SystemExplorerDriver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = SystemExplorerDriver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SystemExplorerDriver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%SystemExplorerDriver.DeviceDesc% = SystemExplorerDriver_Device, Root\SystemExplorerDriver ; TODO: edit hw-id

[SystemExplorerDriver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
SystemExplorerDriver.sys

;-------------- Service installation
[SystemExplorerDriver_Device.NT.Services]
AddService = SystemExplorerDriver,%SPSVCINST_ASSOCSERVICE%, SystemExplorerDriver_Service_Inst

; -------------- SystemExplorerDriver driver install sections
[SystemExplorerDriver_Service_Inst]
DisplayName    = %SystemExplorerDriver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\SystemExplorerDriver.sys

[SystemExplorerDriver_Device.NT.Wdf]
KmdfService = SystemExplorerDriver, SystemExplorerDriver_wdfsect

[SystemExplorerDriver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "SystemExplorerDriver Installation Disk"
SystemExplorerDriver.DeviceDesc = "SystemExplorerDriver Device"
SystemExplorerDriver.SVCDESC = "SystemExplorerDriver Service"
